BLUEPRINT_GH_TOKEN=""
FONTAWESOME_PRO_TOKEN=""

# Password gate — leave empty to disable (development default).
# When set, all routes require this password before access is granted.
# The session cookie expires after 7 days.
PROTOTYPE_PASSWORD=""

# Anthropic API key for the AI assistant. Read server-side only by the
# stream-relay route (src/routes/api/ai.ts → src/ai/relay.ts); never exposed
# to the client.
ANTHROPIC_API_KEY=""

# ElevenLabs API key for text-to-speech (Al's voice). Read server-side only by
# the TTS server fn (src/ai/tts.ts); never exposed to the client. Without it,
# voice falls back to the browser SpeechSynthesis API. Optional overrides:
# ELEVENLABS_AL_VOICE_ID, ELEVENLABS_MODEL.
ELEVENLABS_API_KEY=""

# Slack, for posting a merged PR's changelog entry (scripts/changelogSlack.ts).
# Only needed to post from your own machine — in CI these come from the repo's
# Actions secret and variable of the same names. Bun loads this file
# automatically for `bun run`, so a local `--post` picks them up with no flags.
#
# SLACK_CHANGELOG_CHANNEL takes a channel id (C…) or a user id (U…) for a DM.
SLACK_BOT_TOKEN=""
SLACK_CHANGELOG_CHANNEL=""
